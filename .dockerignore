# Version control
.git
.gitignore

# Dependencies (reinstalled inside the image)
node_modules

# Build artefacts (rebuilt inside the image)
dist

# Environment files — never bake secrets into the image
.env
.env.*
!.env.example

# Editor / OS noise
.vscode
.idea
*.DS_Store
Thumbs.db

# Test artefacts
coverage
*.test.ts

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Docker files themselves (not needed in context)
Dockerfile
.dockerignore

# Manus-specific runtime files (not needed in the container)
.manus
attached_assets
screenshots
